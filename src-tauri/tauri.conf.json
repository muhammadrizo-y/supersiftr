{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "supersiftr",
  "version": "0.1.0",
  "identifier": "com.mhmdrz.supersiftr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Supersiftr",
        "width": 1200,
        "height": 800,
        "center": true,
        "visible": false,
        "backgroundColor": "#151515",
        "decorations": false,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
